# ───────────────────────────────────────────────────────────
# ☁️ Cloudflare R2 Object Storage
# ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=ds-agent-storage
R2_PUBLIC_URL=https://<your_r2_dev_subdomain>.r2.dev

# ───────────────────────────────────────────────────────────
# 🗄️ Supabase Cloud Database (PostgreSQL)
# ───────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_server_service_role_key
ENABLE_CLOUD_SYNC=false

# ───────────────────────────────────────────────────────────
# 🤖 NVIDIA NIM API Keys (Round-Robin)
# ───────────────────────────────────────────────────────────
NVIDIA_API_KEY_1=nvapi-key-1
NVIDIA_API_KEY_2=nvapi-key-2
NVIDIA_API_KEY_3=nvapi-key-3
NVIDIA_API_KEY_4=nvapi-key-4
NVIDIA_API_KEY_5=nvapi-key-5
NVIDIA_API_KEY_6=nvapi-key-6

# ───────────────────────────────────────────────────────────
# 🔐 Security & JWT Authentication
# ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=
# Blank generates a persistent random local signing key; use >=32 random characters on servers.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PYTHON_TIMEOUT_SECONDS=15
PYTHON_MEMORY_MB=512
# Optional absolute path shared by API and Streamlit:
# DS_AGENT_DB_PATH=C:/data/ds_agent.db

# ───────────────────────────────────────────────────────────
# 🌐 Server & App Settings
# ───────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=8501
ENVIRONMENT=development

# Dataset and job limits (one API process; --workers 1)
MAX_UPLOAD_BYTES=10485760
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=128
MAX_DATASET_CELLS=2000000
MAX_DATASET_MEMORY_BYTES=104857600
MAX_CACHED_SESSIONS=8
MAX_PROJECTS_PER_USER=20
MAX_SESSION_STORAGE_BYTES=104857600
JOB_WORKERS=3
MAX_PENDING_JOBS=12
MAX_JOBS_PER_USER=3
JOB_RETENTION_SECONDS=604800
MAX_JOB_HISTORY=200

# Groq and NVIDIA names match backend/config.py; set only the keys you actually use.
GROQ_API_KEY_1=
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
DEFAULT_PROVIDER=groq

# Task-specific routing is in backend/model_routes.json; DEFAULT_PROVIDER is for
# older callers that do not supply a task. Keys stay server-side.
Gemini_ApiKey_1=
Gemini_ApiKey_2=
Gemini_ApiKey_3=
Gemini_ApiKey_4=
Gemini_ApiKey_5=
Gemini_ApiKey_6=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.8-flash
NVIDIA_SUPER_VL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_RPM=40
GROQ_RPM=30
GROQ_TPM=8000
GEMINI_FAST_RPM=15
GEMINI_REASONING_RPM=5

# Optional: used only by testing_tools/fetch_kaggle_datasets.py.
KAGGLE_API_TOKEN=
